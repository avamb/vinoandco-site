---
/**
 * The site's forms in the look of the Elementor Pro form widget: contact form
 * (contact page), private-event request (popup on private events) and club
 * sign-up (popup on home). Sending goes to the platform with Cloudflare
 * Turnstile (spec 62 §10.2): src/scripts/site-forms.ts. Without a Turnstile
 * site key in the build the form says it is unavailable and sends nothing.
 */
import { ui } from '../lib/i18n.ts';
import { pagePath } from '../lib/routes.ts';
import { arena, turnstile, type LanguageCode } from '../../site.config.ts';

interface Props {
  lang: LanguageCode;
  kind: 'contact' | 'private' | 'club';
}
const { lang, kind } = Astro.props;
const f = ui(lang).forms;
const id = `vc-form-${kind}`;
const texts = {
  unavailable: f.unavailable,
  sending: f.sending,
  sent: kind === 'contact' ? f.sentContact : kind === 'private' ? f.sentPrivate : f.sentClub,
  captchaWait: f.captchaWait,
  errors: f.errors,
};
---
<form
  class="vc-form"
  id={id}
  data-form-kind={kind}
  data-lang={lang}
  data-api={arena.apiBase}
  data-feed={arena.feedToken}
  data-sitekey={turnstile.siteKey}
  data-texts={JSON.stringify(texts)}
  novalidate
>
  {kind === 'contact' ? (
    <>
      <div class="vc-form__field">
        <label class="is-required" for={`${id}-first`}>{f.firstName}</label>
        <input type="text" id={`${id}-first`} name="first_name" placeholder={f.firstName} required autocomplete="given-name" />
      </div>
      <div class="vc-form__field">
        <label class="is-required" for={`${id}-last`}>{f.lastName}</label>
        <input type="text" id={`${id}-last`} name="last_name" placeholder={f.lastName} required autocomplete="family-name" />
      </div>
    </>
  ) : (
    <div class="vc-form__field vc-form__field--full">
      <label class="is-required" for={`${id}-name`}>{f.firstName}</label>
      <input type="text" id={`${id}-name`} name="name" placeholder={f.fullNamePlaceholder} required autocomplete="name" />
    </div>
  )}
  <div class:list={['vc-form__field', { 'vc-form__field--full': kind !== 'contact' }]}>
    <label class="is-required" for={`${id}-email`}>{f.email}</label>
    <input type="email" id={`${id}-email`} name="email" placeholder={f.email} required autocomplete="email" />
  </div>
  <div class:list={['vc-form__field', { 'vc-form__field--full': kind !== 'contact' }]}>
    <label class="is-required" for={`${id}-phone`}>{f.phone}</label>
    <input type="tel" id={`${id}-phone`} name="phone" placeholder={f.phonePlaceholder} required autocomplete="tel" />
  </div>
  {kind !== 'club' && (
    <div class="vc-form__field vc-form__field--full">
      <label class:list={{ 'is-required': kind === 'private' }} for={`${id}-message`}>{f.message}</label>
      <textarea id={`${id}-message`} name="message" rows="4" required={kind === 'private'}></textarea>
    </div>
  )}
  {kind === 'club' && (
    <div class="vc-form__field vc-form__field--full vc-form__consent">
      <label class="is-required"><input type="checkbox" name="marketing" required /> {f.club.optin}</label>
    </div>
  )}
  <div class="vc-form__field vc-form__field--full vc-form__consent">
    <span class="is-required">{f.consent}</span>
    <label>
      <input type="checkbox" name="consent" required />
      {f.consentBefore} <a href={pagePath('terms', lang)}>{f.consentTerms}</a> {f.consentAnd} <a href={pagePath('privacy', lang)}>{f.consentPrivacy}</a> {f.consentAfter}
    </label>
  </div>
  <div class="vc-form__field vc-form__field--full vc-form__turnstile" data-turnstile></div>
  <p class="vc-form__status vc-form__field--full" data-form-status role="status" hidden></p>
  <div class="vc-form__field vc-form__field--full vc-form__actions">
    <button type="submit" class="vc-btn vc-btn--gold">{kind === 'contact' ? f.sendMessage : f.send}</button>
  </div>
</form>

<script>
  import { createArenaClient } from '../arena/client.ts';
  import { initSiteForm, loadTurnstileScript } from '../scripts/site-forms.ts';

  document.querySelectorAll<HTMLFormElement>('form[data-form-kind]').forEach((form) => {
    initSiteForm(form, {
      client: createArenaClient({ apiBase: form.dataset.api ?? '', feedToken: form.dataset.feed ?? '' }),
      loadTurnstile: loadTurnstileScript,
      siteKey: form.dataset.sitekey ?? '',
      locale: form.dataset.lang ?? 'ru',
      pageUrl: () => location.origin + location.pathname,
    });
  });
</script>
