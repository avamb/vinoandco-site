---
/** Private events (Elementor page 521 / 1710 en / 1729 he) with the request popup. */
import Base from '../../layouts/Base.astro';
import PageHero from '../PageHero.astro';
import Split from '../Split.astro';
import Popup from '../Popup.astro';
import SiteForm from '../SiteForm.astro';
import { blocksContent } from '../../lib/content.ts';
import { pagePaths } from '../../lib/routes.ts';
import { ui } from '../../lib/i18n.ts';
import type { LanguageCode } from '../../../site.config.ts';

interface Props {
  lang: LanguageCode;
}
const { lang } = Astro.props;
const c = blocksContent(lang, 'private');
const t = ui(lang);
const [intro = '', body = ''] = c.texts;
---
<Base lang={lang} title={c.title} description={c.description} alternates={pagePaths.private}>
  <PageHero bg="vc-bg-private" page="private" title={c.h1}>
    <Fragment set:html={intro} />
  </PageHero>
  <Split image="/_site/img/dsc09713-1024x683.jpg" eyebrow={c.h4[0]} html={body} reverse wide darkDots layout="private">
    <a class="vc-btn vc-btn--gold" href="#request" data-open-popup="vc-popup-private">{c.buttons[0]}</a>
  </Split>
  <section class="vc-gallery" aria-label={c.h1}>
    <img src="/_site/img/fb_img_1718947333887.jpg" alt="" width="911" height="682" loading="lazy" />
    <img src="/_site/img/dsc09977.jpg" alt="" width="1000" height="667" loading="lazy" />
    <img src="/_site/img/dsc02061-scaled.jpg" alt="" width="2560" height="1706" loading="lazy" />
  </section>
  <Popup id="vc-popup-private" closeLabel={t.modal.close}>
    <p>{t.forms.private.intro}</p>
    <SiteForm lang={lang} kind="private" />
  </Popup>
</Base>
