---
/**
 * Order status ("Спасибо", WordPress page 1250 / 1760 en / 2126 he). The state
 * comes only from GET /v1/public/checkout/{token} (spec 62 §5.5); the island
 * takes the token from the address once, keeps it in sessionStorage and removes
 * it from the URL. Personal page: no-store, no third-party scripts, noindex (§5.6).
 */
import Base from '../../layouts/Base.astro';
import OrderStatus from '../islands/OrderStatus.svelte';
import { ui } from '../../lib/i18n.ts';
import { pagePath, pagePaths } from '../../lib/routes.ts';
import { arena, brand, siteUrl, type LanguageCode } from '../../../site.config.ts';

interface Props {
  lang: LanguageCode;
}
const { lang } = Astro.props;
const t = ui(lang).orderStatus;
---
<Base lang={lang} title={`${t.title} — Vino&Co`} alternates={pagePaths.orderStatus} personal>
  <section class="vc-personal">
    <h1>{t.title}</h1>
    <div class="vc-personal__box">
      <OrderStatus
        client:load
        t={t}
        apiBase={arena.apiBase}
        feedToken={arena.feedToken}
        myTicketsPath={pagePath('myTickets', lang)}
        upcomingPath={pagePath('upcoming', lang)}
        shareUrl={new URL(pagePath('upcoming', lang), siteUrl).href}
        contactEmail={brand.email}
      />
    </div>
  </section>
</Base>
