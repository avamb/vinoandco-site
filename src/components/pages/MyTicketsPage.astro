---
/**
 * "My tickets by link" (spec 62 §7, replaces the WooCommerce account page): the
 * island asks for an e-mailed link, spends its one-time token on a button press
 * and lists the orders of the 4-hour session. Personal page: no-store, noindex,
 * no third-party scripts (§5.6).
 */
import Base from '../../layouts/Base.astro';
import MyTickets from '../islands/MyTickets.svelte';
import { ui, language } from '../../lib/i18n.ts';
import { pagePath, pagePaths } from '../../lib/routes.ts';
import { arena, siteUrl, turnstile, type LanguageCode } from '../../../site.config.ts';

interface Props {
  lang: LanguageCode;
}
const { lang } = Astro.props;
const t = ui(lang).myTickets;
---
<Base lang={lang} title={`${t.title} — Vino&Co`} alternates={pagePaths.myTickets} personal>
  <section class="vc-personal">
    <h1>{t.title}</h1>
    <div class="vc-personal__box">
      <MyTickets
        client:load
        t={t}
        apiBase={arena.apiBase}
        feedToken={arena.feedToken}
        lang={lang}
        intl={language(lang).intl}
        pageUrl={new URL(pagePath('myTickets', lang), siteUrl).href}
        upcomingPath={pagePath('upcoming', lang)}
        siteKey={turnstile.siteKey}
      />
    </div>
  </section>
</Base>
