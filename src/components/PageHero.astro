---
/** Full-width photo header with centred title and text (pages about, private, contact, past). */
interface Props {
  /** CSS class that sets the background photo (see global.css `.vc-bg-*`). */
  bg: string;
  title: string;
  short?: boolean;
  /** WordPress page this hero copies: sets the measured height, offsets and text width. */
  page?: 'about' | 'past' | 'contact' | 'private';
}
const { bg, title, short = false, page } = Astro.props;
---
<section class:list={['vc-hero', bg, { 'vc-hero--short': short }, page && `vc-hero--${page}`]}>
  <div class="vc-hero__body">
    <h1>{title}</h1>
    <slot />
  </div>
</section>
