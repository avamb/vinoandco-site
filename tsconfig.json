{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@config": ["site.config.ts"]
    },
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "noEmit": true
  },
  "include": [".astro/types.d.ts", "src/**/*", "site.config.ts", "scripts/**/*"],
  "exclude": ["dist", "node_modules", "docs"]
}
