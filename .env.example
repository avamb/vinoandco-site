# Build-time settings. All values here are PUBLIC; nothing secret belongs in this file.
# Copy to .env for local work. The production values are set in the deploy environment.

# Public origin of this build (staging: https://new.vinoandco.events).
SITE_URL=https://vinoandco.events
# false on staging: every page gets noindex, robots.txt disallows everything.
SITE_INDEXING=false
# Arena platform public API origin.
PUBLIC_ARENA_API=https://api.arenasoldout.com
# Public feed token of the site's sales channel (empty = build from src/data/events.sample.json).
PUBLIC_FEED_TOKEN=
# Meta Pixel id and GA4 measurement id (loaded only after cookie consent).
PUBLIC_META_PIXEL_ID=
PUBLIC_GA4_ID=
# Optional path to an events snapshot JSON written by the builder.
EVENTS_SNAPSHOT=
