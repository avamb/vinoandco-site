# Build-time settings. All values here are PUBLIC; nothing secret belongs in this file.
# Copy to .env for local work. The production values are set in the deploy environment.

# Public origin of this build (staging: https://new.vinoandco.events).
SITE_URL=https://vinoandco.events
# false on staging: every page gets noindex, robots.txt disallows everything.
SITE_INDEXING=false
# Arena platform public API origin.
PUBLIC_ARENA_API=https://api.arenasoldout.com
# Public feed token of the site's sales channel (empty = build from src/data/events.sample.json).
# The Vino&Co site channel (public value, used by the staging build):
#   PUBLIC_FEED_TOKEN=c3b8fabb2ddae303928f662a1022469e830205fd0be5cd46a5d3c22c1d3456de
PUBLIC_FEED_TOKEN=
# Meta Pixel id and GA4 measurement id (loaded only after cookie consent).
PUBLIC_META_PIXEL_ID=
PUBLIC_GA4_ID=
# Cloudflare Turnstile SITE key of the contact, private-event and club forms (public value; the
# secret key lives in the platform). Empty = the forms are disabled and say so.
PUBLIC_TURNSTILE_SITE_KEY=
# Optional path to an events snapshot JSON written by the builder.
EVENTS_SNAPSHOT=

# Builder (docker compose --profile builder). Secret values are NOT kept here:
# CF_API_TOKEN (Zone.Cache Purge of vinoandco.events) and CF_ZONE_ID are set in
# the deploy environment only. Without them the builder skips the purge.
# BUILDER_POLL_SECONDS=120
